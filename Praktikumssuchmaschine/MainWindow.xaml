<Window x:Class="Praktikumssuchmaschine.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Praktikumssuchmaschine" Height="600" Width="850">
    <DockPanel Margin="10">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="OriginText" FontWeight="Bold" Margin="0,0,0,8" />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Umkreis (km):" VerticalAlignment="Center" />
                <TextBox x:Name="RadiusBox" Text="10" Width="60" Margin="8,0,16,0" />
                <TextBlock Text="Max. Anzahl:" VerticalAlignment="Center" />
                <TextBox x:Name="MaxResultsBox" Text="30" Width="60" Margin="8,0,16,0" />
                <Button x:Name="SearchButton" Content="Suchen" Width="100" Click="SearchButton_Click" />
                <Button x:Name="CancelButton" Content="Abbrechen" Width="100" Margin="8,0,0,0" IsEnabled="False" Click="CancelButton_Click" />
                <Button x:Name="ExportButton" Content="Export Excel" Width="100" Margin="16,0,0,0" IsEnabled="False" Click="ExportButton_Click" />
            </StackPanel>

            <TextBlock Text="Branchen:" Margin="0,0,0,4" />
            <WrapPanel x:Name="IndustryPanel" Margin="0,0,0,8" />
        </StackPanel>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" />

        <DataGrid x:Name="ResultGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="Branche" Binding="{Binding Industry}" Width="*" />
                <DataGridTextColumn Header="Adresse" Binding="{Binding Address}" Width="2*" />
                <DataGridTextColumn Header="Entfernung (km)" Binding="{Binding DistanceKm, StringFormat=N1}" Width="Auto" />
            </DataGrid.Columns>
        </DataGrid>

    </DockPanel>
</Window>
